{
  "schemaVersion": "1.0.0",
  "package": "@konitif/viewer-3d",
  "intent": "Project a subject into a 3D scene without granting the view authority over the subject.",
  "clusters": [
    {
      "id": "spatial-contracts",
      "title": "Spatial contracts",
      "summary": "Geometric values for the 3D projection.",
      "authority": "Spatial representation contracts.",
      "owns": [
        "vectors",
        "rotations",
        "transforms"
      ],
      "doesNotOwn": [
        "subject identity"
      ],
      "workflow": [
        "Describe",
        "Transform",
        "Project"
      ],
      "symbolNames": [
        "Viewer3DVector",
        "Viewer3DQuaternion",
        "Viewer3DTransform"
      ]
    },
    {
      "id": "scene-projection",
      "title": "Scene projection",
      "summary": "Snapshots and ports that make a scene observable.",
      "authority": "Derived scene state.",
      "owns": [
        "snapshot",
        "port"
      ],
      "doesNotOwn": [
        "domain state"
      ],
      "workflow": [
        "Adapt",
        "Project",
        "Observe"
      ],
      "symbolNames": [
        "Viewer3DSceneSnapshot",
        "Viewer3DPort",
        "createViewer3DSceneSnapshot"
      ]
    },
    {
      "id": "renderer-projection",
      "title": "Renderer projection",
      "summary": "Three.js runtime supplied through an explicit entry point and fed by borrowed ports.",
      "authority": "State and lifecycle of the visual projection.",
      "owns": [
        "Three.js scene",
        "projection camera",
        "display cadence",
        "renderer lifecycle"
      ],
      "doesNotOwn": [
        "subject identity",
        "simulation policy",
        "observation protocol",
        "host shell"
      ],
      "workflow": [
        "Receive",
        "Project",
        "Observe",
        "Dispose"
      ],
      "symbolNames": [
        "Viewer3D",
        "Viewer3DOptions",
        "normalizeConfiguredDisplayFrameRate"
      ]
    },
    {
      "id": "composition-integration",
      "title": "Composition and host contribution",
      "summary": "3D specialization of a composition source and a portable host contribution.",
      "authority": "Amodal Viewer contract specialized by the 3D incarnation.",
      "owns": [
        "composition source",
        "intent",
        "module"
      ],
      "doesNotOwn": [
        "host runtime",
        "amodal Viewer contract"
      ],
      "workflow": [
        "Declare",
        "Connect",
        "Use"
      ],
      "symbolNames": [
        "Viewer3DIntent",
        "ViewerWorkflowCompositionSource",
        "createViewerWorkflowCompositionSource",
        "Viewer3DWorkflowCompositionSource",
        "createViewer3DWorkflowCompositionSource",
        "viewer3DToolModule"
      ]
    }
  ]
}
